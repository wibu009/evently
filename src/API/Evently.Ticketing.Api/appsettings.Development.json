{
  "ConnectionStrings": {
    "WriteDatabase": "Host=evently.write.db;Port=5432;Database=evently_ticketing;Username=postgres;Password=postgres;Include Error Detail=true;",
    "ReadDatabase": "mongodb://admin:admin@evently.read.database:27017",
    "Cache": "evently.cache:6379",
    "Queue": "amqp://evently-queue:5672"
  },
  "Authentication": {
    "Audience": "account",
    "TokenValidationParameters": {
      "ValidIssuers": ["http://evently.idp:8080/realms/evently", "http://localhost:18080/realms/evently"]
    },
    "MetadataAddress": "http://evently.idp:8080/realms/evently/.well-known/openid-configuration",
    "RequireHttpsMetadata": false
  },
  "KeyCloak": {
    "HealthUrl": "http://evently.idp:9000/health/"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Evently.Modules.Ticketing.Infrastructure.Outbox": "Warning",
        "Evently.Modules.Ticketing.Infrastructure.Inbox": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://evently.seq:5341"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "Evently.Ticketing.Api"
    }
  },
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://evently.trace:4317"
}
