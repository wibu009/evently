<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.6.0" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- ASPIRE010: the AppHost is used for local orchestration only; the Aspire CLI
         bundle (aspire publish/deploy) is intentionally not used. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.6.0" />
    <PackageReference Include="Aspire.Hosting.MongoDB" Version="13.6.0" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.6.0" />
    <PackageReference Include="Aspire.Hosting.RabbitMQ" Version="13.6.0" />
    <PackageReference Include="Aspire.Hosting.Redis" Version="13.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\API\Evently.Api\Evently.Api.csproj" />
    <ProjectReference Include="..\..\API\Evently.Gateway\Evently.Gateway.csproj" />
    <ProjectReference Include="..\..\API\Evently.Ticketing.Api\Evently.Ticketing.Api.csproj" />
  </ItemGroup>

</Project>
